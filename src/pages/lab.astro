---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Roofline from '../components/Roofline.astro';
import { machines, rules, benchFacts } from '../data/lab';
import { dim } from '../data/img-dims';

const statusColor: Record<string, string> = {
  Active: 'text-[var(--accent)] border-[rgb(var(--accent-rgb)/0.45)]',
  Planned: 'text-[var(--fg-faint)] border-[var(--hairline)]',
  Retired: 'text-[var(--fg-faint)] border-[var(--hairline)] line-through',
};

const headerMeta = [
  ['Machines', String(machines.length)],
  ['On the bench', String(machines.filter((m) => m.status === 'Active').length)],
  ['Rules', String(rules.length)],
  ['Telemetry', '13 h open dataset'],
] as const;
---

<Base
  title="Lab"
  description="The measurement bench behind the research: hardware, instrumentation, and the rules every published number has to survive."
>
  <PageHeader
    label="Lab"
    meta={headerMeta}
    title="Where the numbers come from."
    lede="Every claim on this site traces back to hardware sitting on a desk. This page is the machines, the on-board instrumentation they already carry, and the rules a result has to survive before it gets written down."
  />

  {/* the argument, drawn */}
  <Section
    heading="One diagram explains most of it."
    lede="The roofline. Performance climbs with arithmetic intensity until the machine runs out of memory bandwidth or compute, whichever comes first. The research program is, in one sentence: real edge workloads live on the left slope."
  >
    <Roofline />
  </Section>

  {/* bench facts */}
  <section class="border-y border-[var(--hairline)]">
    <dl class="mx-auto grid max-w-6xl grid-cols-2 lg:grid-cols-4">
      {
        benchFacts.map((f, i) => (
          <div
            class:list={[
              'px-5 py-7 sm:px-8',
              i % 2 === 1 && 'border-l border-[var(--hairline)]',
              i >= 2 && 'border-t border-[var(--hairline)] lg:border-t-0',
              i === 2 && 'lg:border-l',
              i === 3 && 'lg:border-l',
            ]}
          >
            <dd
              class="font-mono text-3xl font-light tracking-tight tabular-nums sm:text-4xl"
            >
              {f.value}
            </dd>
            <dt class="label mt-2">{f.label}</dt>
          </div>
        ))
      }
    </dl>
  </section>

  {/* machines */}
  <Section
    heading="The bench."
    tone="raised"
    lede="Small, deliberate, and instrumented without adding a single sensor: the power telemetry and performance counters are already on the die. A short list of machines that are actually measured beats a rack of machines that are merely owned."
  >
    <div class="grid gap-px border border-[var(--hairline)] bg-[var(--hairline)] lg:grid-cols-2">
      {
        machines.map((m, i) => (
          <div class="flex flex-col bg-[var(--bg)]">
            {m.image && (
              <div class="overflow-hidden border-b border-[var(--hairline)]">
                <img
                  src={m.image}
                  {...dim(m.image)}
                  alt={m.imageAlt ?? m.name}
                  loading="lazy"
                  class="aspect-[16/9] w-full object-cover"
                />
              </div>
            )}
            <div class="flex flex-1 flex-col p-7">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="text-xl font-medium tracking-tight">{m.name}</h3>
                <p class="mt-1 font-mono text-[0.6875rem] tracking-[0.1em] text-[var(--fg-faint)] uppercase">
                  {m.role}
                </p>
              </div>
              <span class:list={['tag', statusColor[m.status]]}>{m.status}</span>
            </div>

            <ul class="mt-5 space-y-2">
              {m.spec.map((s) => (
                <li class="flex gap-3 font-mono text-[0.75rem] leading-relaxed text-[var(--fg-muted)]">
                  <span class="text-[var(--accent)] opacity-60">›</span>
                  {s}
                </li>
              ))}
            </ul>

            {m.note && (
              <p class="mt-5 border-t border-[var(--hairline)] pt-4 text-sm leading-relaxed text-[var(--fg-faint)]">
                {m.note}
              </p>
            )}
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  {/* methodology */}
  <Section
    heading="Rules a result has to survive."
    lede="Written down because they cost something. Each of these has, at least once, meant deleting a result that would have made a better headline."
  >
    {/*
      A sticky stack, and the one place on the site the pattern is motivated:
      the rules are sequential and cumulative, so each card pinning on top of
      the ones before it is the content's own shape, not decoration. Pure
      position:sticky, no library, no scroll hijack; the reader's scroll is
      the only controller, and reading order is preserved exactly for
      keyboard, screen-reader and reduced-motion users because nothing here
      is animation at all. Earlier cards stay visible as a ledger of headers.
    */}
    <ol class="rule-stack">
      {
        rules.map((r, i) => (
          <li class="rule-card" style={`--i: ${i}`}>
            <div class="flex items-baseline gap-6 border-b border-[var(--hairline)] px-6 py-4 sm:px-8">
              <span class="font-mono text-sm text-[var(--accent)] tabular-nums">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="text-lg leading-snug font-medium tracking-tight">{r.title}</h3>
            </div>
            <p class="max-w-2xl px-6 py-6 text-sm leading-relaxed text-[var(--fg-muted)] sm:px-8 sm:py-8">
              {r.body}
            </p>
          </li>
        ))
      }
    </ol>
  </Section>
</Base>

<style>
  .rule-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .rule-card {
    /* Pin below the 3.5rem nav, each card a step lower so the covered cards
       remain readable as a stack of numbered headers. */
    position: sticky;
    top: calc(4.5rem + var(--i) * 3.4rem);
    background: var(--bg-raised);
    border: 1px solid var(--hairline);
    box-shadow: 0 -8px 24px rgb(0 0 0 / 0.35);
  }

  /* Give the stack scroll distance to play out; without it the cards pin for
     only a few pixels and the effect reads as a glitch instead of a stack. */
  .rule-card:not(:last-child) {
    min-height: 14rem;
  }

  /* The stacked ledger needs headroom under the nav on short viewports; if
     five headers cannot fit, fall back to an ordinary list. */
  @media (max-height: 620px), (max-width: 640px) {
    .rule-card {
      position: static;
      min-height: 0;
    }
  }
</style>

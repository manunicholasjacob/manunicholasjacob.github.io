---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { updated, current, notDoing } from '../data/now';

const fmt = new Date(updated).toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<Base title="Now" description="What is actually in flight right now.">
  <PageHeader
    label={`Now · updated ${fmt}`}
    title="What I'm doing now."
    lede="A now page, in the spirit of nownow.com: the short list of things actually in flight, kept current or deleted."
  />

  <Section label={`${current.length} active`}>
    <ol class="border-t border-[var(--hairline)]">
      {
        current.map((item, i) => (
          <li
            class="grid gap-4 border-b border-[var(--hairline)] py-8 lg:grid-cols-[4rem_1fr_8rem] lg:gap-10"
            data-reveal={String(Math.min(i, 4) * 60)}
          >
            <span class="font-mono text-sm text-[var(--fg-faint)] tabular-nums">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h2 class="text-xl leading-snug font-medium tracking-tight">{item.title}</h2>
              <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[var(--fg-muted)]">
                {item.detail}
              </p>
            </div>
            <span class="tag tag-accent self-start lg:justify-self-end">{item.status}</span>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section label="Deliberately not doing">
    <ul class="max-w-xl space-y-3">
      {
        notDoing.map((n) => (
          <li class="flex gap-3 text-[var(--fg-muted)]">
            <span class="font-mono text-[var(--fg-faint)]">×</span>
            {n}
          </li>
        ))
      }
    </ul>
    <p class="mt-10 max-w-xl text-sm leading-relaxed text-[var(--fg-faint)]">
      If this page looks stale, it is. The date at the top is the contract.
    </p>
  </Section>
</Base>

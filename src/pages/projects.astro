---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { repos, builds, engineering, upstream, flagship } from '../data/projects';
import { dim } from '../data/img-dims';

const groups = [
  {
    key: 'artifact' as const,
    label: 'Research artifacts',
    lede: 'The harness, data and analysis behind each paper. Archived on Zenodo so a result can be cited and re-run.',
  },
  {
    key: 'tool' as const,
    label: 'Tools',
    lede: 'Things that outgrew the paper they came from and became usable on their own.',
  },
  {
    key: 'lab' as const,
    label: 'Lab and pipelines',
    lede: 'Infrastructure that makes the measurements repeatable.',
  },
];

/**
 * Choose a column count that divides the row exactly, and where it cannot,
 * let the last card span the remainder. These grids show the hairline through
 * a one-pixel gap, so an unfilled cell renders as a grey box, not as space.
 */
const gridFor = (n: number) =>
  n === 1
    ? { cols: '', last: '' }
    : n % 2 === 0
      ? { cols: 'lg:grid-cols-2', last: '' }
      : { cols: 'lg:grid-cols-2', last: 'lg:col-span-2' };

const mergedPrs = upstream.reduce((n, u) => n + u.prs.filter((p) => p.merged).length, 0);
const openPrs = upstream.reduce((n, u) => n + u.prs.filter((p) => !p.merged).length, 0);
const headerMeta = [
  ['Repositories', String(repos.length)],
  ['Archived DOIs', String(repos.filter((r) => r.doi).length + 1)],
  ['Merged upstream', String(mergedPrs)],
  ['Open upstream', String(openPrs)],
] as const;
---

<Base
  title="Projects"
  description="Open-source research artifacts, tools and award-winning hardware builds."
>
  <PageHeader
    label="Projects"
    meta={headerMeta}
    title="Code, benchmarks and hardware."
    lede="A benchmarking platform, the reproducible artifact behind every paper, contributions upstream, and the hardware it all started on."
  />

  {/* flagship platform */}
  <Section
    label="Platform"
    heading={flagship.name}
    lede={flagship.tagline}
    tone="raised"
  >
    <div class="grid gap-px border border-[var(--hairline)] bg-[var(--hairline)] lg:grid-cols-[1.15fr_0.85fr]">
      {/* left: what it is + architecture */}
      <div class="bg-[var(--bg)] p-8">
        <p class="max-w-2xl leading-relaxed text-[var(--fg-muted)]">{flagship.description}</p>

        <p class="label mt-8 mb-4">Architecture</p>
        <ol class="space-y-0">
          {
            flagship.architecture.map((a, i) => (
              <li class="grid items-baseline gap-x-4 gap-y-1 border-t border-[var(--hairline)] py-3 sm:grid-cols-[9.5rem_1fr]">
                <span class="flex items-center gap-2 font-mono text-[0.75rem] text-[var(--accent)]">
                  <span class="text-[var(--fg-faint)]">{String(i + 1).padStart(2, '0')}</span>
                  {a.step}
                </span>
                <span class="text-sm leading-relaxed text-[var(--fg-muted)]">{a.detail}</span>
              </li>
            ))
          }
        </ol>
      </div>

      {/* right: hardware, result, links */}
      <div class="flex flex-col gap-px bg-[var(--hairline)]">
        <div class="bg-[var(--bg)] p-8">
          <p class="label mb-4">Supported hardware</p>
          <ul class="space-y-2.5">
            {
              flagship.hardware.map((h) => (
                <li class="flex gap-3 font-mono text-[0.75rem] leading-relaxed text-[var(--fg-muted)]">
                  <span class="text-[var(--accent)] opacity-60">›</span>
                  {h}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="bg-[var(--bg)] p-8">
          <p class="label mb-4">Representative result</p>
          <p class="border-l-2 border-[var(--accent)] pl-4 text-sm leading-relaxed text-[var(--fg-muted)]">
            {flagship.result}
          </p>
        </div>

        <div class="flex-1 bg-[var(--bg)] p-8">
          <p class="label mb-4">Related publications</p>
          <ul class="space-y-2">
            {
              flagship.related.map((r) => (
                <li>
                  <a href={r.href} class="link-u inline-block py-1 text-sm leading-snug">
                    {r.title}
                  </a>
                </li>
              ))
            }
          </ul>

          <div class="mt-6 flex flex-wrap gap-3 border-t border-[var(--hairline)] pt-6">
            <a href={flagship.url} target="_blank" rel="noopener" class="btn btn-primary">
              GitHub ↗
            </a>
            <a
              href={`https://doi.org/${flagship.doi}`}
              target="_blank"
              rel="noopener"
              class="btn btn-ghost"
            >
              DOI {flagship.doi.split('/').pop()}
            </a>
          </div>

          <div class="mt-5 flex flex-wrap gap-2">
            {flagship.stack.map((s) => <span class="tag">{s}</span>)}
          </div>
        </div>
      </div>
    </div>
  </Section>

  {
    groups.map((g) => {
      const items = repos.filter((r) => r.kind === g.key);
      const { cols, last } = gridFor(items.length);
      return (
        <Section label={g.label} heading={g.label} lede={g.lede}>
          <div class:list={['grid gap-px border border-[var(--hairline)] bg-[var(--hairline)]', cols]}>
            {items.map((r, i) => (
              <a
                href={r.url}
                target="_blank"
                rel="noopener"
                class:list={[
                  'card-link group flex flex-col bg-[var(--bg)] p-7',
                  i === items.length - 1 && last,
                ]}
              >
                <div class="flex items-start justify-between gap-4">
                  <h3 class="font-mono text-sm font-medium break-all group-hover:text-[var(--accent)]">
                    {r.name}
                  </h3>
                  <span class="shrink-0 text-[var(--fg-faint)] transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-[var(--accent)]">
                    ↗
                  </span>
                </div>

                <p class="mt-4 max-w-3xl flex-1 text-sm leading-relaxed text-[var(--fg-muted)]">
                  {r.blurb}
                </p>

                {r.result && (
                  <p class="mt-4 border-l-2 border-[var(--accent)] pl-3 font-mono text-[0.6875rem] text-[var(--accent)]">
                    {r.result}
                  </p>
                )}

                <div class="mt-5 flex flex-wrap items-center gap-2">
                  {r.stack.map((s) => (
                    <span class="tag">{s}</span>
                  ))}
                </div>

                {r.doi && (
                  <p class="mt-4 border-t border-[var(--hairline)] pt-4 font-mono text-[0.625rem] text-[var(--fg-faint)]">
                    DOI {r.doi}
                  </p>
                )}
              </a>
            ))}
          </div>
        </Section>
      );
    })
  }

  {/* upstream contributions */}
  <Section
    label="Upstream"
    heading="Contributions to the infrastructure itself."
    lede="Contributions to the projects this research already depends on. Root-cause habits transfer: read the failing system, isolate the fault, fix the cause rather than the symptom."
  >
    <div class="grid gap-px border border-[var(--hairline)] bg-[var(--hairline)] lg:grid-cols-2">
      {
        upstream.map((u, i) => {
          const merged = u.prs.filter((pr) => pr.merged).length;
          const open = u.prs.length - merged;
          return (
            <div class="flex flex-col bg-[var(--bg)] p-7">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
                <h3 class="text-xl font-medium tracking-tight">
                  {u.org}/<span class="text-[var(--accent)]">{u.project}</span>
                </h3>
                <span class="flex shrink-0 gap-1.5">
                  {merged > 0 && <span class="tag tag-accent">{merged} merged</span>}
                  <span class="tag">{open} open</span>
                </span>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-[var(--fg-muted)]">{u.why}</p>
              <ul class="mt-5 space-y-2.5 border-t border-[var(--hairline)] pt-5">
                {u.prs.map((pr) => (
                  <li>
                    <a
                      href={pr.url}
                      target="_blank"
                      rel="noopener"
                      class="group flex items-baseline gap-3 py-1"
                    >
                      <span
                        class:list={[
                          'shrink-0 font-mono text-[0.6875rem] tabular-nums',
                          pr.merged
                            ? 'text-[var(--accent)]'
                            : 'text-[var(--fg-faint)] group-hover:text-[var(--accent)]',
                        ]}
                      >
                        #{pr.number}
                      </span>
                      <span
                        class:list={[
                          'min-w-0 break-words text-sm leading-snug transition-colors group-hover:text-[var(--fg)]',
                          pr.merged ? 'text-[var(--fg)]' : 'text-[var(--fg-muted)]',
                        ]}
                      >
                        {pr.title}
                      </span>
                      {pr.merged && (
                        <span class="ml-auto shrink-0 font-mono text-[0.5625rem] tracking-[0.14em] text-[var(--accent)] uppercase">
                          Merged
                        </span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
  </Section>

  {/* senior design */}
  <Section
    label="Capstone"
    heading="Seeing potholes coming."
    lede="A year-long, team-built in-vehicle detection system: stereo depth sensing, CNN detection on embedded hardware, a custom PCB, and a driver alert display. Shipped as a product, not a demo."
  >
    {
      engineering.map((p) => (
        <div class="grid gap-px border border-[var(--hairline)] bg-[var(--hairline)] lg:grid-cols-2">
          {p.images.map((img, i) => (
            <div class="overflow-hidden bg-[var(--bg)]">
              <img
                src={img.src}
                {...dim(img.src)}
                alt={img.alt}
                loading="lazy"
                class="aspect-[4/3] w-full object-contain p-4"
              />
            </div>
          ))}
          <div class="bg-[var(--bg)] p-7 lg:col-span-2">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h3 class="text-xl font-medium tracking-tight">{p.name}</h3>
              <span class="font-mono text-[0.625rem] tracking-[0.1em] text-[var(--fg-faint)] uppercase">
                {p.org}
              </span>
            </div>
            <p class="mt-4 max-w-3xl text-sm leading-relaxed text-[var(--fg-muted)]">{p.blurb}</p>
            {p.result && (
              <p class="mt-4 border-l-2 border-[var(--accent)] pl-3 font-mono text-[0.6875rem] text-[var(--accent)]">
                {p.result}
              </p>
            )}
            <div class="mt-5 flex flex-wrap gap-2">
              {p.stack.map((s) => (
                <span class="tag">{s}</span>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </Section>
  {/* hardware builds */}
  <Section
    label="Origins"
    heading="Where the hardware habit started."
    tone="raised"
    lede="Award-winning weekend builds from before the research program. Kept here because everything above traces back to them."
  >
    <div class="grid gap-px border border-[var(--hairline)] bg-[var(--hairline)] lg:grid-cols-3">
      {
        builds.map((b, i) => (
          <div class="ticks group relative flex flex-col bg-[var(--bg)]">
            {b.image && (
              <div class="overflow-hidden border-b border-[var(--hairline)]">
                <img
                  src={b.image}
                  {...dim(b.image)}
                  alt={b.imageAlt ?? b.name}
                  loading="lazy"
                  class="aspect-[16/10] w-full object-cover grayscale-[35%] transition-all duration-500 group-hover:grayscale-0"
                />
              </div>
            )}
            <div class="flex flex-1 flex-col p-7">
              {b.award && <span class="tag tag-accent self-start">{b.award}</span>}
              <h3 class:list={['text-xl font-medium tracking-tight', b.award ? 'mt-6' : 'mt-[3.25rem]']}>
                {b.name}
              </h3>
              <p class="mt-1 font-mono text-[0.6875rem] tracking-[0.1em] text-[var(--fg-faint)] uppercase">
                {b.event}
              </p>
              <p class="mt-4 flex-1 text-sm leading-relaxed text-[var(--fg-muted)]">{b.blurb}</p>
              <div class="mt-5 flex flex-wrap gap-2">
                {b.stack.map((s) => (
                  <span class="tag">{s}</span>
                ))}
              </div>
              <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
                {b.url && (
                  <a
                    href={b.url}
                    target="_blank"
                    rel="noopener"
                    class="link-u inline-block py-1 font-mono text-[0.6875rem]"
                  >
                    Repository ↗
                  </a>
                )}
                {b.media?.map((m) => (
                  <a
                    href={m.href}
                    target="_blank"
                    rel="noopener"
                    class="link-u inline-block py-1 font-mono text-[0.6875rem]"
                  >
                    {m.label} ↗
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

</Base>

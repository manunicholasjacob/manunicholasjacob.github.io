---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { repos, builds, engineering } from '../data/projects';

const groups = [
  {
    key: 'artifact' as const,
    label: 'Research artifacts',
    lede: 'The harness, data and analysis behind each paper. Archived on Zenodo so a result can be cited and re-run.',
  },
  {
    key: 'tool' as const,
    label: 'Tools',
    lede: 'Things that outgrew the paper they came from and became usable on their own.',
  },
  {
    key: 'lab' as const,
    label: 'Lab and pipelines',
    lede: 'Infrastructure that makes the measurements repeatable.',
  },
];
---

<Base
  title="Projects"
  description="Open-source research artifacts, tools and award-winning hardware builds."
>
  <PageHeader
    label="Projects"
    title="Code, benchmarks and hardware."
    lede="Public repositories, most of them the reproducible artifact for a paper. A few are hardware builds that won things."
  />

  {
    groups.map((g) => {
      const items = repos.filter((r) => r.kind === g.key);
      return (
        <Section label={g.label} heading={g.label} lede={g.lede}>
          <div class="grid gap-px border border-[var(--hairline)] bg-[var(--hairline)] lg:grid-cols-2">
            {items.map((r, i) => (
              <a
                href={r.url}
                target="_blank"
                rel="noopener"
                class="card-link group flex flex-col bg-[var(--bg)] p-7"
                data-reveal={String((i % 2) * 80)}
              >
                <div class="flex items-start justify-between gap-4">
                  <h3 class="font-mono text-sm font-medium break-all group-hover:text-[var(--accent)]">
                    {r.name}
                  </h3>
                  <span class="shrink-0 text-[var(--fg-faint)] transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-[var(--accent)]">
                    ↗
                  </span>
                </div>

                <p class="mt-4 flex-1 text-sm leading-relaxed text-[var(--fg-muted)]">{r.blurb}</p>

                {r.result && (
                  <p class="mt-4 border-l-2 border-[var(--accent)] pl-3 font-mono text-[0.6875rem] text-[var(--accent)]">
                    {r.result}
                  </p>
                )}

                <div class="mt-5 flex flex-wrap items-center gap-2">
                  {r.stack.map((s) => (
                    <span class="tag">{s}</span>
                  ))}
                </div>

                {r.doi && (
                  <p class="mt-4 border-t border-[var(--hairline)] pt-4 font-mono text-[0.625rem] text-[var(--fg-faint)]">
                    DOI {r.doi}
                  </p>
                )}
              </a>
            ))}
          </div>
        </Section>
      );
    })
  }

  {/* hardware builds */}
  <Section
    label="Hardware builds"
    heading="Built in a weekend, judged on Sunday."
    lede="Hackathon projects. All three were built to be demonstrated on a table, which is a useful constraint."
  >
    <div class="grid gap-px border border-[var(--hairline)] bg-[var(--hairline)] lg:grid-cols-3">
      {
        builds.map((b, i) => (
          <div class="ticks group relative flex flex-col bg-[var(--bg)]" data-reveal={String(i * 90)}>
            {b.image && (
              <div class="overflow-hidden border-b border-[var(--hairline)]">
                <img
                  src={b.image}
                  alt={b.imageAlt ?? b.name}
                  loading="lazy"
                  class="aspect-[16/10] w-full object-cover grayscale-[35%] transition-all duration-500 group-hover:scale-[1.02] group-hover:grayscale-0"
                />
              </div>
            )}
            <div class="flex flex-1 flex-col p-7">
              <span class="tag tag-accent self-start">{b.award}</span>
              <h3 class="mt-6 text-xl font-medium tracking-tight">{b.name}</h3>
              <p class="mt-1 font-mono text-[0.6875rem] tracking-[0.1em] text-[var(--fg-faint)] uppercase">
                {b.event}
              </p>
              <p class="mt-4 flex-1 text-sm leading-relaxed text-[var(--fg-muted)]">{b.blurb}</p>
              <div class="mt-5 flex flex-wrap gap-2">
                {b.stack.map((s) => (
                  <span class="tag">{s}</span>
                ))}
              </div>
              <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
                {b.url && (
                  <a
                    href={b.url}
                    target="_blank"
                    rel="noopener"
                    class="link-u font-mono text-[0.6875rem]"
                  >
                    Repository ↗
                  </a>
                )}
                {b.media?.map((m) => (
                  <a
                    href={m.href}
                    target="_blank"
                    rel="noopener"
                    class="link-u font-mono text-[0.6875rem]"
                  >
                    {m.label} ↗
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  {/* senior design */}
  <Section
    label="Capstone"
    heading="Senior design: seeing potholes coming."
    lede="The year-long ECE capstone at UMass Amherst: a complete in-vehicle detection system, from stereo depth sensing through a custom PCB to the driver alert."
  >
    {
      engineering.map((p) => (
        <div class="grid gap-px border border-[var(--hairline)] bg-[var(--hairline)] lg:grid-cols-2">
          {p.images.map((img, i) => (
            <div class="overflow-hidden bg-[var(--bg)]" data-reveal={String(i * 90)}>
              <img
                src={img.src}
                alt={img.alt}
                loading="lazy"
                class="aspect-[4/3] w-full object-contain p-4"
              />
            </div>
          ))}
          <div class="bg-[var(--bg)] p-7 lg:col-span-2" data-reveal="180">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h3 class="text-xl font-medium tracking-tight">{p.name}</h3>
              <span class="font-mono text-[0.625rem] tracking-[0.1em] text-[var(--fg-faint)] uppercase">
                {p.org}
              </span>
            </div>
            <p class="mt-4 max-w-3xl text-sm leading-relaxed text-[var(--fg-muted)]">{p.blurb}</p>
            {p.result && (
              <p class="mt-4 border-l-2 border-[var(--accent)] pl-3 font-mono text-[0.6875rem] text-[var(--accent)]">
                {p.result}
              </p>
            )}
            <div class="mt-5 flex flex-wrap gap-2">
              {p.stack.map((s) => (
                <span class="tag">{s}</span>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </Section>
</Base>

---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { peerReview, judging, speaking, volunteering } from '../data/service';
import { site } from '../data/site';
import { dim } from '../data/img-dims';

const headerMeta = [
  ['Review venues', String(peerReview.length)],
  ['Judging', String(judging.length)],
  ['Volunteering', String(volunteering.length)],
  ['Based', site.location],
] as const;
---

<Base
  title="Service"
  description="Artifact evaluation and peer review at research venues, hackathon and robotics judging, speaking, and teaching."
>
  <PageHeader
    label="Service"
    meta={headerMeta}
    title="Reviewing, judging, teaching."
    lede="Evaluating other people's work is the fastest way to stay honest about your own."
  />

  {/* peer review: the research-venue half, kept separate from competition judging */}
  <Section
    label="Peer review"
    heading="Reviewing at research venues."
    lede="Artifact evaluation and journal review. Listed exactly as far as it has actually gone, and no further."
    tone="raised"
  >
    <div class="grid gap-px border border-[var(--hairline)] bg-[var(--hairline)] lg:grid-cols-2">
      {
        peerReview.map((p, i) => (
          <div class="ticks relative flex flex-col bg-[var(--bg)] p-8">
            <div class="flex items-start justify-between gap-3">
              <p class="label">{p.period}</p>
              {p.tag && <span class="tag tag-accent">{p.tag}</span>}
            </div>
            <h3 class="mt-6 text-2xl leading-snug font-medium tracking-tight">{p.org}</h3>
            <p class="mt-1.5 font-mono text-[0.6875rem] text-[var(--accent)]">{p.role}</p>
            <p class="mt-5 flex-1 text-sm leading-relaxed text-[var(--fg-muted)]">{p.detail}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section
    label="Judging"
    heading="On the panel."
    lede="Hackathon and robotics competition judging."
  >
    <div class="grid gap-px border border-[var(--hairline)] bg-[var(--hairline)] lg:grid-cols-3">
      {
        judging.map((j, i) => (
          <div class="ticks relative bg-[var(--bg)] p-7">
            <div class="flex items-start justify-between gap-3">
              <p class="label">{j.period}</p>
            </div>
            <h3 class="mt-5 text-xl leading-snug font-medium tracking-tight">{j.role}</h3>
            <p class="mt-1.5 font-mono text-[0.6875rem] text-[var(--accent)]">{j.org}</p>
            <p class="mt-4 text-sm leading-relaxed text-[var(--fg-muted)]">{j.detail}</p>
          </div>
        ))
      }
    </div>

    {/* from the field */}
    <div class="mt-px grid gap-px border border-t-0 border-[var(--hairline)] bg-[var(--hairline)] sm:grid-cols-2">
      {
        [
          { src: '/img/vex-field-1.jpg', alt: 'A VEX V5 competition field mid-match, robots at both ends' },
          { src: '/img/vex-field-2.jpg', alt: 'A VEX V5 competition field set up before a match' },
        ].map((img, i) => (
          <figure class="group overflow-hidden bg-[var(--bg)]">
            <img
              src={img.src}
              {...dim(img.src)}
              alt={img.alt}
              loading="lazy"
              class="aspect-[16/9] w-full object-cover grayscale-[35%] transition-all duration-500 group-hover:grayscale-0"
            />
          </figure>
        ))
      }
      <figcaption class="bg-[var(--bg)] px-5 py-3 font-mono text-[0.6875rem] tracking-[0.1em] text-[var(--fg-faint)] uppercase sm:col-span-2">
        // From the field · VEX V5 events I judge
      </figcaption>
    </div>
  </Section>

  <Section label="Speaking" heading="Talks and posters.">
    <ul class="border-t border-[var(--hairline)]">
      {
        speaking.map((s, i) => (
          <li
            class="grid gap-3 border-b border-[var(--hairline)] py-7 lg:grid-cols-[10rem_1fr] lg:gap-10"
          >
            <p class="font-mono text-[0.6875rem] tracking-[0.12em] text-[var(--accent)] uppercase">
              {s.period}
            </p>
            <div>
              <h3 class="text-lg font-medium tracking-tight">{s.org}</h3>
              <p class="mt-1 font-mono text-[0.6875rem] tracking-[0.1em] text-[var(--fg-faint)] uppercase">
                {s.role}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-[var(--fg-muted)]">{s.detail}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section
    label="Teaching and volunteering"
    heading="Before any of the rest of it."
    lede="Work with three foundations in India, mostly teaching and mostly with people who had very little margin for error."
  >
    <div class="grid gap-px border border-[var(--hairline)] bg-[var(--hairline)] lg:grid-cols-3">
      {
        volunteering.map((v, i) => (
          <div class="flex flex-col bg-[var(--bg)] p-7">
            <h3 class="text-xl font-medium tracking-tight">{v.org}</h3>
            <p class="mt-1.5 font-mono text-[0.6875rem] text-[var(--accent)]">{v.role}</p>
            <p class="mt-4 flex-1 text-sm leading-relaxed text-[var(--fg-muted)]">{v.blurb}</p>
          </div>
        ))
      }
    </div>

    {/* Photographs from the volunteering, mirroring the 'from the field' strip
        in the judging section above. Portrait source, so it is boxed rather than
        cropped to a letterbox that would cut half the group out. */}
    {
      volunteering.some((v) => v.image) && (
        <div class="mt-px grid gap-px border border-t-0 border-[var(--hairline)] bg-[var(--hairline)] sm:grid-cols-[auto_1fr]">
          {volunteering
            .filter((v) => v.image)
            .map((v) => (
              <figure class="group overflow-hidden bg-[var(--bg)]">
                <img
                  src={v.image}
                  {...dim(v.image)}
                  alt={v.imageAlt ?? v.org}
                  loading="lazy"
                  class="h-full max-h-[26rem] w-full object-contain grayscale-[25%] transition-all duration-500 group-hover:grayscale-0"
                />
              </figure>
            ))}
          <figcaption class="flex items-end bg-[var(--bg)] p-7">
            <p class="max-w-md text-sm leading-relaxed text-[var(--fg-muted)]">
              With students at the Banyan School, Bangalore, 2020. Maths and science for grades 7 to 10,
              and board-exam coaching for the tenth-grade cohort.
              <span class="mt-3 block font-mono text-[0.6875rem] tracking-[0.1em] text-[var(--fg-faint)] uppercase">
                // From the field &middot; Lovedale Foundation
              </span>
            </p>
          </figcaption>
        </div>
      )
    }
  </Section>
</Base>

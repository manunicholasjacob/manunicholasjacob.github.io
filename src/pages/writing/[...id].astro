---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

type Props = { post: CollectionEntry<'writing'> };

const { post } = Astro.props;
const { Content, headings } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });

const toc = headings.filter((h) => h.depth === 2);
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <header class="relative overflow-hidden border-b border-[var(--hairline)]">
      <div class="dotgrid fade-edges pointer-events-none absolute inset-0"></div>
      <div
        class="accent-glow pointer-events-none absolute -top-32 left-1/3 h-72 w-[38rem] -translate-x-1/2"
      >
      </div>

      <div class="relative mx-auto max-w-6xl px-5 pt-16 pb-14 sm:px-8 sm:pt-24 sm:pb-16">
        <a href="/writing" class="label transition-colors hover:text-[var(--accent)]">
          ← All writing
        </a>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <span class="tag tag-accent">{post.data.kind}</span>
          {post.data.draft && <span class="tag">Draft</span>}
          <span class="font-mono text-[0.6875rem] tracking-[0.12em] text-[var(--fg-faint)] uppercase">
            {fmt(post.data.date)}
          </span>
          {
            post.data.readingTime && (
              <span class="font-mono text-[0.6875rem] tracking-[0.12em] text-[var(--fg-faint)] uppercase">
                {post.data.readingTime} min read
              </span>
            )
          }
        </div>

        <h1 class="display-sm mt-6 max-w-4xl">{post.data.title}</h1>
        <p class="lede mt-6 max-w-2xl">{post.data.description}</p>
      </div>
    </header>

    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <div class="grid gap-14 lg:grid-cols-[1fr_15rem] lg:gap-20">
        <div class="prose">
          <Content />
        </div>

        {
          toc.length > 1 && (
            <aside class="order-first lg:order-last">
              <div class="lg:sticky lg:top-24">
                <p class="label mb-4">On this page</p>
                <ul class="space-y-2.5 border-l border-[var(--hairline)] pl-4">
                  {toc.map((h) => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        class="block text-sm leading-snug text-[var(--fg-muted)] transition-colors hover:text-[var(--accent)]"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </aside>
          )
        }
      </div>

      <div class="mt-20 border-t border-[var(--hairline)] pt-10">
        <p class="label">Written by</p>
        <div class="mt-5 flex flex-wrap items-center gap-5">
          <img
            src="/img/manu.jpg"
            alt=""
            width="56"
            height="56"
            class="h-14 w-14 border border-[var(--hairline)] object-cover grayscale"
          />
          <div>
            <p class="font-medium">{site.name}</p>
            <p class="text-sm text-[var(--fg-muted)]">{site.role}</p>
          </div>
          <a href={`mailto:${site.email}`} class="btn btn-ghost ml-auto">Get in touch</a>
        </div>
      </div>
    </div>
  </article>
</Base>

<style is:global>
  /* Anchor offset so the sticky header does not cover a heading you jump to. */
  .prose :is(h2, h3) {
    scroll-margin-top: 6rem;
  }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import TraceStrip from '../components/TraceStrip.astro';
import { site, links, handStats, keywords } from '../data/site';
import { featuredPapers, researchThesis, papers, submittedCount } from '../data/research';
import { repos, upstream, flagship } from '../data/projects';
import { peerReview } from '../data/service';

/**
 * Counted, not typed. `doi` is deduplicated because the flagship also appears
 * in the repo list on /projects, and counting it twice was the shape of the
 * next mistake.
 */
const artifactDois = new Set(
  [flagship.doi, ...repos.map((r) => r.doi)].filter(Boolean) as string[],
);

const stats = [
  { value: String(papers.length), label: 'Papers' },
  { value: String(submittedCount), label: 'Under review' },
  { value: String(artifactDois.size), label: 'Artifact DOIs' },
  ...handStats,
];

const allPrs = upstream.flatMap((u) => u.prs);
const mergedPrs = allPrs.filter((pr) => pr.merged).length;
const openPrs = allPrs.length - mergedPrs;

const writing = (await getCollection('writing', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });

const highlightRepos = repos.filter((r) =>
  ['rpi5-quantization-benchmark', 'edge-llm-memory-wall', 'edge-cold-start-tax', 'llama-roofline'].includes(
    r.slug,
  ),
);

const spec = [
  ['Role', 'Hardware Engineer'],
  ['Org', 'Dell Technologies'],
  ['Focus', 'AI server platforms'],
  ['Research', 'Edge inference, memory systems'],
  ['Location', 'Austin, Texas'],
];
---

<Base>
  {/* ══════════════════════════ HERO ══════════════════════════ */}
  <section class="plus-marks relative overflow-hidden border-b border-[var(--hairline)]">
    <div class="linegrid fade-edges pointer-events-none absolute inset-0"></div>
    <div class="dotgrid fade-edges pointer-events-none absolute inset-0"></div>
    <div
      class="accent-glow pointer-events-none absolute -top-40 left-[15%] h-[34rem] w-[46rem] -translate-x-1/2"
    >
    </div>

    <div class="relative mx-auto max-w-6xl px-5 pt-16 pb-20 sm:px-8 sm:pt-24 sm:pb-28">
      <div class="grid items-center gap-14 lg:grid-cols-[1.25fr_0.75fr] lg:gap-20">
        <div>
          <p class="label mb-7 flex items-center gap-2.5">
            {site.name} &nbsp;/&nbsp; {site.location}
          </p>

          <h1 class="display" data-reveal>
            I find out what actually<br class="hidden sm:block" />
            <span class="hl-draw text-[var(--accent)]">limits</span> a computer.
          </h1>

          <p class="lede mt-8 max-w-xl">
            Hardware engineer at Dell Technologies working on enterprise AI server platforms, and an
            independent researcher on what really governs machine-learning inference at the edge.
            Every number on this site was measured on real silicon.
          </p>

          <div class="mt-10 flex flex-wrap items-center gap-3">
            <a href="/research" class="btn btn-primary">Read the research</a>
            <a href={links.github} target="_blank" rel="noopener" class="btn btn-ghost">
              GitHub ↗
            </a>
          </div>
        </div>

        {/* spec-sheet portrait */}
        <div class="max-w-xs lg:justify-self-end">
          <div class="card ticks group overflow-hidden">
            <img
              src="/img/manu.jpg"
              alt={site.name}
              width="900"
              height="900"
              class="aspect-square w-full object-cover grayscale transition-all duration-700 group-hover:grayscale-0"
            />
          </div>
          <dl class="mt-4 border border-t-0 border-[var(--hairline)]">
            {
              spec.map(([k, v], i) => (
                <div
                  class:list={[
                    'flex items-baseline justify-between gap-4 px-3 py-2',
                    i !== 0 && 'border-t border-[var(--hairline)]',
                  ]}
                >
                  <dt class="font-mono text-[0.6875rem] tracking-[0.12em] text-[var(--fg-faint)] uppercase">
                    {k}
                  </dt>
                  <dd class="text-right font-mono text-[0.6875rem] text-[var(--fg-muted)]">{v}</dd>
                </div>
              ))
            }
          </dl>
          {/* The proof row: the recruiter's and the verifier's next click,
              in the spec card where both are already looking. */}
          <div
            class="flex items-stretch justify-between gap-px border border-t-0 border-[var(--hairline)] bg-[var(--hairline)]"
          >
            <a
              href="/cv"
              class="flex-1 bg-[var(--bg)] px-3 py-2 text-center font-mono text-[0.6875rem] tracking-[0.1em] text-[var(--fg-muted)] uppercase transition-colors hover:bg-[var(--surface-hover)] hover:text-[var(--accent)]"
            >
              CV
            </a>
            <a
              href="/manu-nicholas-jacob-cv.pdf"
              download
              class="flex-1 bg-[var(--bg)] px-3 py-2 text-center font-mono text-[0.6875rem] tracking-[0.1em] text-[var(--fg-muted)] uppercase transition-colors hover:bg-[var(--surface-hover)] hover:text-[var(--accent)]"
            >
              PDF
            </a>
            <a
              href={links.orcid}
              target="_blank"
              rel="noopener"
              class="flex-1 bg-[var(--bg)] px-3 py-2 text-center font-mono text-[0.6875rem] tracking-[0.1em] text-[var(--fg-muted)] uppercase transition-colors hover:bg-[var(--surface-hover)] hover:text-[var(--accent)]"
            >
              ORCID
            </a>
          </div>
        </div>
      </div>
    </div>

    <TraceStrip />

    {/* Working vocabulary, stated once. This used to be an infinite marquee;
        a scrolling keyword ticker is one of the most recognisable stock
        landing-page devices, and a list of topics does not need to move. */}
    <div class="border-t border-[var(--hairline)] py-3">
      <p
        class="mx-auto flex max-w-6xl flex-wrap items-baseline gap-x-3 gap-y-1.5 px-5 font-mono text-[0.6875rem] tracking-[0.16em] text-[var(--fg-faint)] uppercase sm:px-8"
      >
        {
          keywords.map((k, i) => (
            <>
              {i > 0 && <span class="text-[var(--accent)] opacity-60">/</span>}
              <span>{k}</span>
            </>
          ))
        }
      </p>
    </div>

    {/* stats */}
    <div class="border-t border-[var(--hairline)]">
      <dl class="mx-auto grid max-w-6xl grid-cols-2 sm:grid-cols-4">
        {
          stats.map((s, i) => (
            <div
              class:list={[
                'px-5 py-7 sm:px-8',
                i % 2 === 1 && 'border-l border-[var(--hairline)]',
                i >= 2 && 'border-t border-[var(--hairline)] sm:border-t-0',
                i === 2 && 'sm:border-l',
                i === 3 && 'sm:border-l',
              ]}
            >
              <dd
                class="font-mono text-3xl font-light tracking-tight tabular-nums sm:text-4xl"
              >
                {s.value}
              </dd>
              <dt class="label mt-2">{s.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* ══════════════════════════ THESIS ══════════════════════════ */}
  <Section label="The through-line">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
      <h2 class="display-sm" data-reveal>{researchThesis.claim}</h2>
      <div class="prose-block max-w-xl">
        <p>{researchThesis.intro}</p>
        <div class="mt-6 flex flex-wrap gap-x-8 gap-y-2">
          <a href="/research" class="link-u inline-block py-1 font-mono text-sm">Full publication record →</a>
          <a href="/lab" class="link-u inline-block py-1 font-mono text-sm">The bench it runs on →</a>
        </div>
      </div>
    </div>
  </Section>

  {/* ══════════════════════════ FEATURED PAPERS ══════════════════════════ */}
  <Section
    heading="Results that changed how I build."
    lede="Three papers from the current program. Each headline number was reproduced on hardware before it was written down."
    tone="raised"
  >
    {/*
      One anchor result at full weight, two beside it. Three identical towers
      is the single most templated layout on the web, and it also implied the
      three papers matter equally, which they do not: the memory-wall result
      is the thesis, the other two are consequences of it.
    */}
    <div
      class="grid gap-px border border-[var(--hairline)] bg-[var(--hairline)] lg:grid-cols-[1.45fr_1fr] lg:grid-rows-2"
    >
      {
        featuredPapers.map((p, i) => (
          <a
            href={`/research#${p.id}`}
            class:list={[
              'card-link group flex flex-col bg-[var(--bg)] transition-colors',
              i === 0 ? 'p-8 sm:p-10 lg:row-span-2' : 'p-7',
            ]}
          >
            <h3
              class:list={[
                'leading-snug font-medium tracking-tight',
                i === 0 ? 'text-2xl sm:text-3xl sm:leading-tight' : 'text-xl',
              ]}
            >
              {p.title}
            </h3>
            <p
              class:list={[
                'mt-4 leading-relaxed text-[var(--fg-muted)]',
                i === 0 ? 'max-w-xl text-[0.9375rem]' : 'flex-1 text-sm',
              ]}
            >
              {p.claim}
            </p>

            {i === 0 && <span class="flex-1" aria-hidden="true" />}

            {
              i === 0 && p.facts && (
                <dl class="mt-8 border border-[var(--hairline)]">
                  {p.facts.map(([k, v], j) => (
                    <div
                      class:list={[
                        'flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-4 py-3',
                        j !== 0 && 'border-t border-[var(--hairline)]',
                      ]}
                    >
                      <dt class="font-mono text-[0.6875rem] tracking-[0.12em] text-[var(--fg-faint)] uppercase">
                        {k}
                      </dt>
                      <dd class="text-right font-mono text-[0.6875rem] text-[var(--fg-muted)]">
                        {v}
                      </dd>
                    </div>
                  ))}
                </dl>
              )
            }

            <p class="mt-6 border-t border-[var(--hairline)] pt-4 font-mono text-[0.6875rem] leading-relaxed text-[var(--accent)]">
              {p.headline}
            </p>
            <p class="label mt-3">{p.venue}</p>
          </a>
        ))
      }
    </div>

    <p class="mt-8 font-mono text-[0.6875rem] tracking-[0.12em] text-[var(--fg-faint)] uppercase">
      {papers.length} papers total ·
      <a href="/research" class="inline-block py-1 text-[var(--accent)] hover:underline">see all</a>
    </p>
  </Section>

  {/* ══════════════════════════ CODE ══════════════════════════ */}
  <Section
    heading="The code behind the numbers."
    lede="Every published result ships with the harness that produced it, archived on Zenodo with a citable DOI."
  >
    <div class="grid gap-px border border-[var(--hairline)] bg-[var(--hairline)] sm:grid-cols-2">
      {
        highlightRepos.map((r, i) => (
          <a
            href={r.url}
            target="_blank"
            rel="noopener"
            class="card-link group relative bg-[var(--bg)] p-7"
          >
            <div class="flex items-start justify-between gap-4">
              <h3 class="font-mono text-sm font-medium break-all text-[var(--fg)] group-hover:text-[var(--accent)]">
                {r.name}
              </h3>
              <span class="shrink-0 text-[var(--fg-faint)] transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-[var(--accent)]">
                ↗
              </span>
            </div>

            <p class="mt-4 text-sm leading-relaxed text-[var(--fg-muted)]">{r.blurb}</p>

            {r.result && (
              <p class="mt-4 font-mono text-[0.6875rem] text-[var(--accent)]">{r.result}</p>
            )}

            <div class="mt-5 flex flex-wrap items-center gap-2">
              {r.stack.map((s) => (
                <span class="tag">{s}</span>
              ))}
              {r.doi && <span class="tag">DOI</span>}
            </div>
          </a>
        ))
      }
    </div>

    <a href="/projects" class="link-u mt-7 inline-block py-1 font-mono text-sm">All projects →</a>
  </Section>

  {/* ══════════════════════════ BEYOND THE PAPERS ══════════════════════════ */}
  <Section
    heading="The rest of the practice."
    lede="A research program needs infrastructure, and a field needs people who maintain it, review it, and judge it. All three are part of the job."
    tone="raised"
  >
    <div class="grid gap-px border border-[var(--hairline)] bg-[var(--hairline)] lg:grid-cols-3">
      {/* platform */}
      <a
        href="/projects"
        class="card-link ticks group flex flex-col bg-[var(--bg)] p-7"
        data-reveal
      >
        <p class="label">Platform</p>
        <h3 class="mt-5 text-xl font-medium tracking-tight group-hover:text-[var(--accent)]">
          {flagship.name}
        </h3>
        <p class="mt-3 flex-1 text-sm leading-relaxed text-[var(--fg-muted)]">
          {flagship.tagline} A reproducible benchmarking framework spanning laptops, Raspberry Pi
          and GPUs, with per-rail power, thermal and utilization telemetry in every record.
        </p>
        <p class="mt-5 border-t border-[var(--hairline)] pt-4 font-mono text-[0.6875rem] leading-relaxed text-[var(--accent)]">
          Reproduces the published roofline fits exactly; independent campaigns agree within 1.7%
        </p>
        <p class="label mt-3">DOI {flagship.doi}</p>
      </a>

      {/* upstream */}
      <a
        href="/projects"
        class="card-link ticks group flex flex-col bg-[var(--bg)] p-7"
      >
        <p class="label">Upstream</p>
        <h3 class="mt-5 text-xl font-medium tracking-tight group-hover:text-[var(--accent)]">
          Fixes to the field's infrastructure
        </h3>
        <p class="mt-3 flex-1 text-sm leading-relaxed text-[var(--fg-muted)]">
          Three merged correctness fixes in NVIDIA's garak, plus open pull requests to vLLM: tokenizer
          edge cases, JIT preflight, benchmark robustness, harness correctness. Root-cause habits,
          applied upstream.
        </p>
        <p class="mt-5 border-t border-[var(--hairline)] pt-4 font-mono text-[0.6875rem] leading-relaxed text-[var(--accent)]">
          {mergedPrs} merged, {openPrs} open across {upstream.map((u) => u.project).join(' and ')}
        </p>
        <p class="label mt-3">vllm-project · NVIDIA</p>
      </a>

      {/* judging */}
      <a
        href="/service"
        class="card-link ticks group flex flex-col bg-[var(--bg)] p-7"
      >
        <p class="label">Peer review</p>
        <h3 class="mt-5 text-xl font-medium tracking-tight group-hover:text-[var(--accent)]">
          Artifact Evaluation Committee, {peerReview[0].org}
        </h3>
        <p class="mt-3 flex-1 text-sm leading-relaxed text-[var(--fg-muted)]">
          Assessing submitted artifacts for functionality and reproducibility at a CORE A systems
          venue. One review delivered for the Journal of Open Source Software and three more
          assigned, plus repeat judging at hackathons and VEX Robotics events.
        </p>
        <p class="mt-5 border-t border-[var(--hairline)] pt-4 font-mono text-[0.6875rem] leading-relaxed text-[var(--accent)]">
          ATC '26 · JOSS · HackTX · VEX Robotics
        </p>
        <p class="label mt-3">Service →</p>
      </a>
    </div>
  </Section>

  {/* ══════════════════════════ WRITING ══════════════════════════ */}
  {
    writing.length > 0 && (
      <Section heading="Recent notes.">
        <ul class="border-t border-[var(--hairline)]">
          {writing.map((post, i) => (
            <li>
              <a
                href={`/writing/${post.id}`}
                class="group grid gap-2 border-b border-l-2 border-[var(--hairline)] border-l-transparent py-6 pl-4 transition-colors hover:border-l-[var(--accent)] hover:bg-[var(--surface)] sm:grid-cols-[8rem_1fr_2rem] sm:items-baseline sm:gap-8"
              >
                <span class="font-mono text-[0.6875rem] tracking-[0.1em] text-[var(--fg-faint)] uppercase">
                  {fmtDate(post.data.date)}
                </span>
                <span>
                  <span class="text-lg font-medium tracking-tight group-hover:text-[var(--accent)]">
                    {post.data.title}
                  </span>
                  <span class="mt-1 block text-sm text-[var(--fg-muted)]">
                    {post.data.description}
                  </span>
                </span>
                <span class="hidden text-[var(--fg-faint)] transition-all group-hover:translate-x-1 group-hover:text-[var(--accent)] sm:block sm:text-right">
                  →
                </span>
              </a>
            </li>
          ))}
        </ul>
        <a href="/writing" class="link-u mt-7 inline-block py-1 font-mono text-sm">
          All writing →
        </a>
      </Section>
    )
  }
</Base>

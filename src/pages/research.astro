---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import DecodeRoofline from '../components/DecodeRoofline.astro';
import { papers, researchThesis, submittedCount } from '../data/research';

/* Chronological by submission date; the one undated paper (awaiting its CFP)
   closes the list. The chart that used to sit above this list is gone: the
   dates themselves carry the story. */
const ordered = [...papers].sort((a, b) =>
  (a.submitted ?? '9999').localeCompare(b.submitted ?? '9999'),
);
import { links } from '../data/site';

const profiles = [
  { label: 'Google Scholar', href: links.scholar },
  { label: 'ORCID 0009-0007-6589-6572', href: links.orcid },
];

const pad = (n: number) => String(n + 1).padStart(2, '0');

/** BibTeX for the artifact (the DOI-bearing, citable object). */
const bibtex = (p: (typeof papers)[number]) =>
  p.artifact
    ? [
        `@software{jacob_${p.id.replaceAll('-', '_')}_${p.year},`,
        `  author = {Jacob, Manu Nicholas},`,
        `  title  = {${p.title}},`,
        `  year   = {${p.year}},`,
        `  doi    = {${p.artifact.doi}},`,
        `  url    = {https://doi.org/${p.artifact.doi}}`,
        `}`,
      ].join('\n')
    : null;

/* Header facts, counted from the record rather than typed out, so they cannot
   drift away from the list further down the page. */
const underReview = papers.filter((p) => p.status === 'Under review').length;
const firstSubmitted = papers
  .map((p) => p.submitted)
  .filter(Boolean)
  .sort()[0]!;
const headerMeta = [
  ['Papers', String(papers.length)],
  ['Under review', String(underReview)],
  ['Venues', String(new Set(papers.map((p) => p.venue)).size)],
  [
    'Since',
    new Date(firstSubmitted + 'T00:00:00Z').toLocaleDateString('en-GB', {
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    }),
  ],
] as const;
---

<Base
  title="Research"
  description={`${papers.length} papers on what governs machine-learning inference on real hardware: memory bandwidth, thermal limits, energy, and quantization.`}
>
  <PageHeader
    label="Research"
    meta={headerMeta}
    title="Measured, not simulated."
    lede={`An independent research program on edge and embedded machine-learning systems: ${papers.length} papers measured on Arm Cortex-A76 and x86 silicon with hardware performance counters and on-board power instrumentation, ${submittedCount} currently under review.`}
  />

  {/* thesis */}
  <Section label="The claim" tone="raised">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
      <h2 class="display-sm">{researchThesis.claim}</h2>
      <div class="prose-block max-w-xl">
        <p>{researchThesis.body}</p>
        <div class="mt-8 flex flex-wrap gap-2">
          {
            profiles.map((p) => (
              <a href={p.href} target="_blank" rel="noopener" class="btn btn-ghost !h-9 !px-4">
                {p.label} ↗
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </Section>

  {/* the claim, plotted from the measurements rather than asserted */}
  <Section
    label="The evidence"
    heading="What the measurements actually look like."
    lede="Ten configurations across an Arm SBC and an x86 laptop, plotted from the public artifact. Each machine's measured memory bandwidth draws a ceiling, and decode runs right underneath it on both."
  >
    <DecodeRoofline />
  </Section>

  {/* full list */}
  <Section label={`Publications · ${papers.length}`}>
    <ol class="border-t border-[var(--hairline)]">
      {
        ordered.map((p, i) => (
          <li
            id={p.id}
            class="group scroll-mt-24 border-b border-[var(--hairline)] py-9 transition-colors hover:bg-[var(--surface)]"
          >
            <div class="grid gap-6 px-1 sm:px-4 lg:grid-cols-[3rem_1fr_15rem] lg:gap-10">
              <span class="font-mono text-sm text-[var(--fg-faint)] tabular-nums transition-colors group-hover:text-[var(--accent)]">
                {pad(i)}
              </span>

              <div>
                <h3 class="text-2xl leading-tight font-medium tracking-tight text-balance">
                  {p.title}
                </h3>
                <p class="mt-4 max-w-2xl leading-relaxed text-[var(--fg-muted)] text-pretty">
                  {p.claim}
                </p>
                <p class="mt-5 border-l-2 border-[var(--accent)] pl-4 font-mono text-[0.8125rem] leading-relaxed text-[var(--accent)]">
                  {p.headline}
                </p>

                <div class="mt-5 flex flex-wrap gap-2">
                  {p.topics.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>

                {bibtex(p) && (
                  <details class="cite mt-5">
                    <summary class="inline-flex cursor-pointer items-center gap-2 font-mono text-[0.6875rem] tracking-[0.12em] text-[var(--fg-faint)] uppercase transition-colors select-none hover:text-[var(--accent)]">
                      <span class="cite-chev inline-block transition-transform">›</span> Cite
                    </summary>
                    <div class="relative mt-3 max-w-xl">
                      <pre class="overflow-x-auto border border-[var(--hairline)] bg-[var(--surface)] p-4 font-mono text-[0.6875rem] leading-relaxed text-[var(--fg-muted)]">{bibtex(p)}</pre>
                      <button
                        type="button"
                        class="copy-bib btn btn-ghost absolute top-2 right-2 !h-7 !px-2.5 !text-[0.5625rem]"
                        data-bib={bibtex(p)}
                      >
                        Copy
                      </button>
                    </div>
                  </details>
                )}
              </div>

              <div class="lg:text-right">
                <p class="text-sm leading-snug font-medium">{p.venue}</p>
                <p class="label mt-2">{p.venueTier}</p>
                <p class="mt-3 flex items-center gap-2 font-mono text-[0.6875rem] text-[var(--fg-muted)] lg:justify-end">
                  <span
                    class:list={[
                      'inline-block h-1.5 w-1.5 rounded-full',
                      /review|revision/i.test(p.status)
                        ? 'bg-[var(--accent)]'
                        : 'border border-[var(--fg-faint)]',
                    ]}
                  ></span>
                  {p.status}
                </p>
                <p class="mt-1 font-mono text-[0.625rem] text-[var(--fg-faint)]">{p.dateline}</p>

                {p.artifact && (
                  <div class="mt-5 border-t border-[var(--hairline)] pt-4 lg:border-t-0 lg:pt-0">
                    <p class="label mb-2">Artifact</p>
                    <a
                      href={`${links.github}/${p.artifact.repo}`}
                      target="_blank"
                      rel="noopener"
                      class="link-u inline-block py-1 font-mono text-[0.6875rem] break-all"
                    >
                      {p.artifact.repo} ↗
                    </a>
                    <a
                      href={`https://doi.org/${p.artifact.doi}`}
                      target="_blank"
                      rel="noopener"
                      class="link-u mt-0.5 inline-block py-1 font-mono text-[0.6875rem] break-all text-[var(--fg-faint)]"
                    >
                      {p.artifact.doi}
                    </a>
                  </div>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="mt-10 max-w-2xl text-sm leading-relaxed text-[var(--fg-faint)]">
      Statuses are kept current by hand and papers are listed in submission order. Work that failed
      to reproduce under re-examination was withdrawn rather than listed, and corrections to our own
      published claims are recorded in the papers that supersede them.
    </p>
  </Section>
</Base>

<style>
  .cite summary::-webkit-details-marker {
    display: none;
  }
  .cite summary {
    list-style: none;
  }
  .cite[open] .cite-chev {
    transform: rotate(90deg);
  }
</style>

<script>
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.copy-bib');
    if (!btn) return;
    try {
      await navigator.clipboard.writeText(btn.dataset.bib ?? '');
      const prev = btn.textContent;
      btn.textContent = 'Copied';
      setTimeout(() => (btn.textContent = prev), 1400);
    } catch {
      /* clipboard unavailable: the text is right there to select by hand */
    }
  });
</script>

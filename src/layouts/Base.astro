---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Palette from '../components/Palette.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} · Writing`}
      href="/rss.xml"
    />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/img/manu.jpg', Astro.site ?? site.url)} />
    <meta name="twitter:card" content="summary_large_image" />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: site.name,
        url: site.url,
        email: `mailto:${site.email}`,
        jobTitle: 'Hardware Engineer',
        worksFor: { '@type': 'Organization', name: 'Dell Technologies' },
        address: { '@type': 'PostalAddress', addressLocality: 'Austin', addressRegion: 'TX' },
        alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Massachusetts Amherst' },
        sameAs: [
          'https://github.com/manunicholasjacob',
          'https://www.linkedin.com/in/manu-nicholas-jacob/',
          'https://orcid.org/0009-0007-6589-6572',
        ],
      })}
    />

    <!-- Set the theme before first paint so there is no flash. Dark is the
         brand default; the OS preference only wins once the user has chosen. -->
    <script is:inline>
      try {
        const stored = localStorage.getItem('theme');
        if (stored) document.documentElement.dataset.theme = stored;
      } catch {}
      // Opt in to the reveal animation only once we know scripting works.
      document.documentElement.classList.add('js');
    </script>

    <ClientRouter />
  </head>

  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[100] focus:bg-[var(--accent)] focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:text-[var(--on-accent)]"
      >Skip to content</a
    >

    <Nav />
    <main id="main"><slot /></main>
    <Footer />
    <Palette />

    <script>
      /* Re-runs on every ClientRouter navigation (astro:page-load fires on the
         initial load as well), because the swapped-in body carries fresh
         [data-reveal] elements. */
      const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* Count-up: elements with data-countup animate their leading number from
         zero once revealed. Decimal places and any suffix are preserved. */
      const countUp = (el: HTMLElement) => {
        const m = (el.textContent ?? '').trim().match(/^([\d.]+)([\s\S]*)$/);
        if (!m) return;
        const target = parseFloat(m[1]);
        if (!isFinite(target)) return;
        const decimals = (m[1].split('.')[1] || '').length;
        const suffix = m[2];
        const t0 = performance.now();
        const dur = 900;
        const tick = (t: number) => {
          const p = Math.min((t - t0) / dur, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = (target * eased).toFixed(decimals) + suffix;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      const initPage = () => {
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
        const counters = new Set(document.querySelectorAll<HTMLElement>('[data-countup]'));

        const reveal = (el: HTMLElement) => {
          el.classList.add('is-visible');
          el.querySelectorAll<HTMLElement>('[data-countup]').forEach((c) => {
            if (counters.delete(c)) countUp(c);
          });
        };
        const showAll = () => {
          els.forEach((el) => el.classList.add('is-visible'));
          counters.clear();
        };

        if (els.length && 'IntersectionObserver' in window && !reduced()) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (!e.isIntersecting) continue;
                const el = e.target as HTMLElement;
                setTimeout(() => reveal(el), Number(el.dataset.reveal) || 0);
                io.unobserve(el);
              }
            },
            { rootMargin: '0px 0px -12% 0px' },
          );
          els.forEach((el) => io.observe(el));

          // Counters outside any reveal container still animate on view.
          if (counters.size) {
            const cio = new IntersectionObserver((entries) => {
              for (const e of entries) {
                if (!e.isIntersecting) continue;
                const c = e.target as HTMLElement;
                if (counters.delete(c)) countUp(c);
                cio.unobserve(c);
              }
            });
            counters.forEach((c) => cio.observe(c));
          }

          // Safety net: if the observer never fires (background tab, odd
          // embed, a browser quirk), show everything rather than a blank page.
          setTimeout(showAll, 2500);
        } else {
          showAll();
        }
      };

      document.addEventListener('astro:page-load', initPage);

      /* Cursor spotlight: one delegated listener feeds --mx/--my to whichever
         card the pointer is over. Document-level, so it survives navigations. */
      if (window.matchMedia('(hover: hover)').matches) {
        document.addEventListener('pointermove', (e) => {
          const card = (e.target as Element | null)?.closest?.('.card-link') as HTMLElement | null;
          if (!card) return;
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - r.left}px`);
          card.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      }
    </script>
  </body>
</html>

---
/**
 * Submission cadence: the publication record against the calendar.
 *
 * The list below reads as twelve equal rows and hides the real shape of the
 * year. Earlier versions of this plotted marks on a true time axis, which
 * failed on this data: three papers went out on the same day and a fourth the
 * day after, so the marks collided into an unreadable stack.
 *
 * So the axis is banded by month instead. Each month is a band whose width
 * grows with how many papers it holds, and marks sit evenly spaced inside it.
 * Nothing can overlap, empty months still take up space so the gaps read as
 * time passing, and the burst shows up as the widest band rather than as a pile.
 */
import { papers } from '../data/research';

type Mark = {
  id: string;
  title: string;
  tier: string;
  open: boolean;
  when: string;
};

/* Only papers with a real date land on the axis. The rest are counted as queue. */
const dated = papers
  .filter((p) => p.submitted || p.deadline)
  .map((p) => ({
    id: p.id,
    title: p.title,
    tier: p.venueTier,
    open: !p.submitted,
    when: p.dateline,
    iso: (p.submitted ?? p.deadline)!,
  }))
  .sort((a, b) => a.iso.localeCompare(b.iso));

/* Band by month across exactly the range the record covers, empty months in
   between included. Hardcoding the window drifted once already: it opened on a
   May band left over from a paper that was dropped, so the chart advertised a
   submission that no longer existed. */
const monthKeys = (() => {
  const seen = [...new Set(dated.map((d) => d.iso.slice(0, 7)))].sort();
  if (!seen.length) return [];
  const out: string[] = [];
  const [y0, m0] = seen[0].split('-').map(Number);
  const [y1, m1] = seen[seen.length - 1].split('-').map(Number);
  for (let y = y0, m = m0; y < y1 || (y === y1 && m <= m1); m === 12 ? ((m = 1), y++) : m++) {
    out.push(`${y}-${String(m).padStart(2, '0')}`);
  }
  return out;
})();

const MONTH_NAMES = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

const bands = monthKeys.map((key) => {
  const label = MONTH_NAMES[Number(key.slice(5, 7)) - 1];
  const inMonth = dated.filter((d) => d.iso.startsWith(key));

  /* Cluster by day. Spacing every mark evenly across the month hid the thing
     the chart exists to show: five of these went out on one afternoon, and
     evenly spaced dots make that look like five separate weeks. */
  const byDay = new Map<string, Mark[]>();
  for (const { iso, ...m } of inMonth) {
    const day = iso.slice(8, 10);
    if (!byDay.has(day)) byDay.set(day, []);
    byDay.get(day)!.push(m);
  }
  const groups = [...byDay.entries()]
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([day, marks]) => ({ day, marks }));

  /* Band width tracks volume: one unit of breathing room, plus two per paper.
     A busy month is visibly wider, which is the whole point of the chart. */
  return { label, marks: inMonth as Mark[], groups, grow: 1 + inMonth.length * 2 };
});

/* The legend explains the shapes that are actually on the axis, in the order
   they first appear. Hardcoding it drifts: an earlier version advertised a
   "DATE 2027 deadline, 20 Sep" long after that paper had been submitted. */
const TIER_ORDER = ['Journal', 'Letters', 'Conference', 'Workshop'];
const tiersPresent = TIER_ORDER.filter((t) => dated.some((d) => d.tier === t));

/* Anything with no date at all is genuinely waiting on something. Name what. */
const waiting = papers.filter((p) => !p.submitted && !p.deadline);
const submitted = papers.filter((p) => p.submitted).length;
const peak = Math.max(...bands.map((b) => b.marks.length));
const peakBand = bands.find((b) => b.marks.length === peak)!;
---

<figure class="cadence" data-reveal>
  <figcaption class="sr-only">
    Submission cadence, May to September 2026, grouped by month. {submitted} papers
    submitted, with {peak} of them in {peakBand.label}. Mark shape carries the venue
    tier. {waiting.length} further {waiting.length === 1 ? 'paper is' : 'papers are'} written
    and waiting on a call for papers.
  </figcaption>

  <div class="cad-bands">
    {
      bands.map((b) => (
        <div
          class:list={['cad-band', b.marks.length === 0 && 'is-empty']}
          style={`flex-grow:${b.grow}`}
        >
          <div class="cad-head">
            <span class="cad-month">{b.label}</span>
            {b.marks.length > 0 && <span class="cad-count">{b.marks.length}</span>}
          </div>

          <div class="cad-marks">
            {
              b.groups.map((g) => (
                <div class="cad-group">
                  <div class="cad-group-marks">
                    {g.marks.map((m) => (
                      <a
                        href={`#${m.id}`}
                        class:list={['cad-mark', m.open && 'is-open']}
                        data-tier={m.tier}
                        aria-label={`${m.title}. ${m.tier}. ${m.when}.`}
                      >
                        <span class="cad-dot" aria-hidden="true" />
                        <span class="cad-tip" aria-hidden="true">
                          <span class="cad-tip-title">{m.title}</span>
                          <span class="cad-tip-meta">
                            {m.tier} · {m.when}
                          </span>
                        </span>
                      </a>
                    ))}
                  </div>
                  <span class="cad-day" aria-hidden="true">
                    {g.day}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      ))
    }
  </div>

  <div class="cadence-legend">
    {
      tiersPresent.map((t) => (
        <span>
          <span class="cad-key" data-tier={t} aria-hidden="true" />
          {t}
        </span>
      ))
    }
    {
      waiting.length > 0 && (
        <span class="cad-note">
          {waiting.length} more written, waiting on a call for papers
        </span>
      )
    }
  </div>
</figure>

<style>
  .cadence {
    border: 1px solid var(--hairline);
    background: var(--surface);
    padding: 1.75rem 1.5rem 1.25rem;
  }

  .cad-bands {
    display: flex;
    align-items: stretch;
  }

  .cad-band {
    /* grow set inline from the paper count */
    flex-basis: 0;
    min-width: 0;
    padding-bottom: 0.75rem;
    border-left: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .cad-band:last-child {
    border-right: 1px solid var(--hairline);
  }

  /* A month with nothing in it still occupies the axis, so the gap reads as
     time passing rather than as a month that did not exist. */
  .cad-band.is-empty {
    background-image: repeating-linear-gradient(
      -45deg,
      var(--dot) 0 1px,
      transparent 1px 7px
    );
  }

  .cad-head {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0 0 0.6rem 0.55rem;
  }

  .cad-month {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .cad-count {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }

  .cad-marks {
    display: flex;
    align-items: flex-end;
    justify-content: space-evenly;
    min-height: 2.6rem;
  }

  .cad-mark {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.75rem;
  }

  .cad-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .cad-group-marks {
    display: flex;
    align-items: center;
  }

  /* Day of the month under each cluster, so a stack of five reads as one day. */
  .cad-day {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    color: var(--fg-faint);
  }

  .cad-dot {
    width: 9px;
    height: 9px;
    border: 1px solid var(--accent);
    background: var(--accent);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  /* A future deadline is hollow: nothing has been delivered for it yet. */
  .cad-mark.is-open .cad-dot {
    background: transparent;
  }

  /* Venue tier is carried by shape, not a second accent colour, so it survives
     greyscale printing and does not spend colour the palette has not got. */
  .cad-mark[data-tier='Journal'] .cad-dot {
    border-radius: 50%;
    width: 11px;
    height: 11px;
  }

  .cad-mark[data-tier='Conference'] .cad-dot {
    transform: rotate(45deg);
  }

  .cad-mark[data-tier='Workshop'] .cad-dot {
    width: 7px;
    height: 7px;
  }

  .cad-mark:hover .cad-dot,
  .cad-mark:focus-visible .cad-dot {
    transform: scale(1.45);
    box-shadow: 0 0 0 4px rgb(var(--accent-rgb) / 0.18);
  }

  .cad-mark[data-tier='Conference']:hover .cad-dot,
  .cad-mark[data-tier='Conference']:focus-visible .cad-dot {
    transform: rotate(45deg) scale(1.45);
  }

  /* tooltip */
  .cad-tip {
    position: absolute;
    bottom: 1.9rem;
    left: 50%;
    z-index: 5;
    width: max-content;
    max-width: 14rem;
    transform: translateX(-50%) translateY(4px);
    display: grid;
    gap: 0.15rem;
    padding: 0.5rem 0.7rem;
    text-align: left;
    background: var(--bg-raised);
    border: 1px solid var(--hairline-strong);
    box-shadow: var(--shadow);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }

  .cad-mark:hover .cad-tip,
  .cad-mark:focus-visible .cad-tip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* First and last band cannot centre their tooltips without leaving the panel. */
  .cad-band:first-child .cad-tip {
    left: 0;
    transform: translateX(0) translateY(4px);
  }

  .cad-band:last-child .cad-tip {
    left: auto;
    right: 0;
    transform: translateX(0) translateY(4px);
  }

  .cad-band:first-child .cad-mark:hover .cad-tip,
  .cad-band:first-child .cad-mark:focus-visible .cad-tip,
  .cad-band:last-child .cad-mark:hover .cad-tip,
  .cad-band:last-child .cad-mark:focus-visible .cad-tip {
    transform: translateX(0) translateY(0);
  }

  .cad-tip-title {
    font-size: 0.75rem;
    line-height: 1.3;
    font-weight: 500;
    color: var(--fg);
  }

  .cad-tip-meta {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .cadence-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--hairline);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .cadence-legend > span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cad-key {
    width: 9px;
    height: 9px;
    border: 1px solid var(--accent);
    background: var(--accent);
  }

  /* Same shape vocabulary as the marks on the axis. */
  .cad-key[data-tier='Journal'] {
    border-radius: 50%;
    width: 11px;
    height: 11px;
  }

  .cad-key[data-tier='Conference'] {
    transform: rotate(45deg);
  }

  .cad-key[data-tier='Workshop'] {
    width: 7px;
    height: 7px;
  }

  .cad-note {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .cadence {
      padding-inline: 0.75rem;
    }
    .cad-head {
      padding-left: 0.35rem;
    }
    .cad-mark {
      width: 1.15rem;
    }
    /* Hover affordance only; a tap just jumps to the entry. */
    .cad-tip {
      display: none;
    }
  }
</style>

---
import { nav, site } from '../data/site';

const { pathname } = Astro.url;
const isActive = (href: string) => pathname === href || pathname === href + '/';
---

<header
  class="site-nav sticky top-0 z-50 border-b border-[var(--hairline)] bg-[var(--bg)]/80 backdrop-blur-xl backdrop-saturate-150"
>
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-5 sm:px-8">
    <a
      href="/"
      class="group flex shrink-0 items-center gap-2.5 font-mono text-[0.6875rem] font-bold tracking-[0.16em] uppercase"
    >
      <span
        class="grid h-6 w-6 place-items-center border border-[var(--hairline-strong)] text-[0.625rem] text-[var(--accent)] transition-colors group-hover:border-[var(--accent)]"
        >{site.shortName.slice(0, 2)}</span
      >
      <span class="hidden sm:inline">{site.name}</span>
    </a>

    <nav class="ml-auto hidden items-center md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'px-2 py-2 font-mono text-[0.6875rem] font-medium tracking-[0.14em] uppercase transition-colors lg:px-3',
              isActive(item.href)
                ? 'text-[var(--accent)]'
                : 'text-[var(--fg-muted)] hover:text-[var(--fg)]',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 md:ml-0">
      <button
        id="palette-open"
        type="button"
        aria-label="Search the site"
        class="hidden h-8 items-center gap-2 border border-[var(--hairline)] px-2.5 font-mono text-[0.625rem] tracking-[0.1em] text-[var(--fg-faint)] uppercase transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)] lg:flex"
      >
        <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <kbd class="font-mono">Ctrl K</kbd>
      </button>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle colour theme"
        class="grid h-8 w-8 place-items-center border border-[var(--hairline)] text-[var(--fg-muted)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
      >
        <svg
          class="theme-icon-light h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
        <svg
          class="theme-icon-dark h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19"
          ></path>
        </svg>
      </button>

      <a
        href={`mailto:${site.email}`}
        class="btn btn-ghost hidden !h-8 !px-3.5 sm:max-md:inline-flex lg:inline-flex">Contact</a
      >

      <button
        id="menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        class="grid h-8 w-8 place-items-center border border-[var(--hairline)] text-[var(--fg-muted)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)] md:hidden"
      >
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-[var(--hairline)] md:hidden">
    <nav class="mx-auto grid max-w-6xl px-5 py-2 sm:px-8">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'border-b border-[var(--hairline)] py-3 font-mono text-[0.6875rem] tracking-[0.14em] uppercase last:border-0',
              isActive(item.href) ? 'text-[var(--accent)]' : 'text-[var(--fg-muted)]',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={`mailto:${site.email}`}
        class="py-3 font-mono text-[0.6875rem] tracking-[0.14em] text-[var(--fg-muted)] uppercase"
        >Contact</a
      >
    </nav>
  </div>
</header>

<script>
  /* The header is server-rendered fresh on every navigation (so the active
     link updates), which means bindings must be re-attached per page. */
  const bind = () => {
    const root = document.documentElement;

    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const apply = () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
      };
      // Crossfade the whole switch instead of an abrupt brightness jump.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced && 'startViewTransition' in document) {
        (document as any).startViewTransition(apply);
      } else {
        apply();
      }
    });

    document.getElementById('palette-open')?.addEventListener('click', () => {
      (window as any).openPalette?.();
    });

    const menuBtn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    menuBtn?.addEventListener('click', () => {
      const open = menu?.classList.toggle('hidden') === false;
      menuBtn.setAttribute('aria-expanded', String(open));
    });
  };

  /* Depth on scroll: the bar earns its shadow only once content is under it. */
  const onScroll = () => {
    document.querySelector('.site-nav')?.classList.toggle('is-scrolled', window.scrollY > 8);
  };
  window.addEventListener('scroll', onScroll, { passive: true });

  document.addEventListener('astro:page-load', () => {
    bind();
    onScroll();
  });
</script>
